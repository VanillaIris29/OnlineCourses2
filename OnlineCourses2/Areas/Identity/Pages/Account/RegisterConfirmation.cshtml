@page
@model ResetPasswordConfirmationModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="modal fade show" id="passwordChangedModal" tabindex="-1" style="display:block; background:rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Паролата е сменена успешно</h5>
            </div>

            <div class="modal-body">
                Можете да влезете с новата си парола.
            </div>

            <div class="modal-footer">
                <a href="/Identity/Account/Login" class="btn btn-primary">Към вход</a>
            </div>

        </div>
    </div>
</div>

<script>
    setTimeout(function () {
        window.location.href = "/Identity/Account/Login";
    }, 2000);
</script>