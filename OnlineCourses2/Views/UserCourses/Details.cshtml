@model OnlineCourses2.Models.Course

<main style="max-width: 900px; margin: 40px auto; padding: 0 20px;">

    <h2 style="margin-bottom: 20px;">@Model.Title</h2>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" style="width:100%; max-height:350px; object-fit:cover; border-radius:10px;" />
    }
    else
    {
        <div style="width:100%; height:250px; background:#e0e0e0; border-radius:10px;
                        display:flex; align-items:center; justify-content:center; color:#777;">
            Няма снимка
        </div>
    }

    <div style="margin-top: 20px;">
        <h3 style="margin-top: 25px;">Описание</h3>
        <p>@Model.Description</p>
        <p><strong>Часове продължителност:</strong> @Model.DurationHours часа</p>
        <p><strong>Цена:</strong> @Model.Price €</p>
        <p><strong>Записани:</strong> @Model.CurrentParticipants / @Model.MaxParticipants</p>
        <p><strong>Свободни места:</strong> @(Model.MaxParticipants - Model.CurrentParticipants)</p>
        <p><strong>Дни продължителност:</strong> @Model.DurationDays дни</p>
        <p><strong>Начална дата:</strong> @Model.StartDate.ToString("dd.MM.yyyy")</p>
        <p><strong>Крайна дата:</strong> @Model.EndDate.ToString("dd.MM.yyyy")</p>
        <p><strong>Категория:</strong> @Model.Category?.Name</p>
        <p><strong>Сертификат:</strong> @(Model.HasCertificate ? "Да" : "Не")</p>
        <hr />

       @if (!User.Identity.IsAuthenticated)
{
    <button onclick="showLoginModal()"
        style="background-color:#81d8b0; color:white; border:none;
               padding:10px 25px; border-radius:6px; font-weight:500; cursor:pointer;">
    Запиши се
</button>

}
else if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
{
    <p>Нямате право да се записвате.</p>
}
else if ((ViewBag.IsEnrolled as bool? ?? false))
{
    <p>Вече сте записан.</p>
}
else if (Model.CurrentParticipants >= Model.MaxParticipants)
{
    <button disabled>Курсът е пълен</button>
}
else if (Model.EndDate < DateTime.Today)
{
    <button disabled>Курсът е изтекъл</button>
}
else
{
    <form method="post" asp-action="Enroll" asp-route-id="@Model.Id">
       <button type="submit"
        style="background-color:#81d8b0; color:white; border:none;
               padding:10px 25px; border-radius:6px; font-weight:500; cursor:pointer;">
    Запиши се
</button>

    </form>
}
        
    </div>

    <a asp-action="All" style="display:inline-block; margin-top:20px; text-decoration:none; color:#555;">
        ← Назад към всички курсове
    </a>

</main>

<div id="loginModal" class="modal-overlay">
    <div class="modal-box">
        <button class="modal-close" onclick="closeLoginModal()">✕</button>

        <h3 class="modal-title">Не сте влезли в профила си</h3>
        <p class="modal-text">
            За да се запишете в курса, моля влезте в профила си или си създайте регистрация.
        </p>

        <div class="modal-buttons">
            <a href="/Identity/Account/Login"
   style="background-color:#81d8b0; color:white; border:none;
          padding:10px 20px; border-radius:6px; font-weight:500;
          cursor:pointer; text-decoration:none; display:inline-block;">
    Вход
</a>

<a href="/Identity/Account/Register"
   style="background-color:#bfbfbf; color:white; border:none;
          padding:10px 20px; border-radius:6px; font-weight:500;
          cursor:pointer; text-decoration:none; display:inline-block;">
    Регистрация
</a>
        </div>
    </div>
</div>
<style>
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.modal-box {
    background: #fff;
    padding: 28px;
    border-radius: 14px;
    width: 90%;
    max-width: 420px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    position: relative;
    text-align: center;
}

.modal-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
}

.modal-text {
    color: #555;
    font-size: 15px;
    line-height: 1.5;
}

.modal-buttons {
    margin-top: 22px;
    display: flex;
    justify-content: center;
    gap: 12px;
}

.modal-btn {
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    color: white;
    transition: 0.2s;
}

/* Вход – зелено */
.modal-login {
    background-color:#81d8b0;
}
.modal-login:hover {
    background-color:#6bcaa0;
}

/* Регистрация – елегантно сиво */
.modal-register {
    background-color:#6c757d;
}
.modal-register:hover {
    background-color:#5a6369;
}

.modal-close {
    position: absolute;
    top: 10px;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 20px;
    color: #777;
    cursor: pointer;
}
.modal-close:hover {
    color: #333;
}
</style>
<script>
function showLoginModal() {
    document.getElementById("loginModal").style.display = "flex";
}

function closeLoginModal() {
    document.getElementById("loginModal").style.display = "none";
}

window.onclick = function (event) {
    let modal = document.getElementById("loginModal");
    if (event.target === modal) {
        modal.style.display = "none";
    }
}

</script>